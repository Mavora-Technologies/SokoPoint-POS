generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  tenantId         String    @default("demo-tenant")
  email            String    @unique
  password         String
  firstName        String?
  lastName         String?
  businessName     String?
  role             String    @default("ADMIN")
  createdAt        DateTime  @default(now())
  
  initiatedRefunds Refund[]  @relation("InitiatedRefunds")
  approvedRefunds  Refund[]  @relation("ApprovedRefunds")
}

model Product {
  id           String      @id @default(cuid())
  tenantId     String      @default("demo-tenant")
  name         String
  sku          String?     @unique
  sellingPrice Float
  stock        Int         @default(0)
  minimumStock Int         @default(5)
  category     String?
  imageUrl     String?  
  status       String      @default("ACTIVE")
  createdAt    DateTime    @default(now())
  
  orderItems   OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  tenantId  String      @default("demo-tenant")
  orderNum  String      @unique
  customer  String      @default("Walk-in Customer")
  total     Float
  status    String      @default("Completed")
  method    String   
  createdAt DateTime    @default(now())
  
  items     OrderItem[]
  refunds   Refund[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Refund {
  id          String   @id @default(cuid())
  tenantId    String   @default("demo-tenant")
  orderId     String
  initiatorId String
  approverId  String
  amount      Float
  reason      String
  status      String   @default("Approved")
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  initiator   User     @relation("InitiatedRefunds", fields: [initiatorId], references: [id], onDelete: Restrict)
  approver    User     @relation("ApprovedRefunds", fields: [approverId], references: [id], onDelete: Restrict)
}

model Expense {
  id            String   @id @default(cuid())
  tenantId      String   @default("demo-tenant")
  amount        Float
  paymentMethod String
  reference     String?
  notes         String?
  expenseDate   DateTime @default(now())
  categoryName  String?
  userName      String
}

model PurchaseOrder {
  id           String   @id @default(uuid())
  tenantId     String   @default("demo-tenant")
  poNumber     String?  @unique
  supplierName String
  itemsSummary String
  totalCost    Float
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  location   String
  manager    String
  phone      String
  status     String
  staffCount Int
  createdAt  DateTime @default(now())
}

model Till {
  id          String    @id @default(uuid())
  name        String
  branch      String
  status      String
  floatAmount Float
  cashier     String?
  lastOpened  DateTime?
  createdAt   DateTime  @default(now())
}

model Shift {
  id          String    @id @default(uuid())
  cashierName String
  tillName    String
  status      String    @default("Active")
  startTime   DateTime  @default(now())
  endTime     DateTime?
  totalSales  Float     @default(0.0)
  createdAt   DateTime  @default(now())
}

model Customer {
  id        String   @id @default(uuid())
  name      String   @default("Valary")
  email     String?  @unique
  phone     String?
  points    Int      @default(0)
  createdAt DateTime @default(now())
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String
  email         String?
  phone         String
  category      String
  createdAt     DateTime @default(now())
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
}

model CreditAccount {
  id           String   @id @default(uuid())
  customerName String
  phone        String
  balance      Float    @default(0.0)
  status       String   @default("Active")
  lastTxDate   DateTime @default(now())
  createdAt    DateTime @default(now())
}